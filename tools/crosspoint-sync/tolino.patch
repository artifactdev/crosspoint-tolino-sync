+      || c.req.header('x-auth-user') !== undefined || c.req.header('x-auth-key') !== undefined) {
+      return next();
+    }
+    // Not included in API CORS allowHeaders: only the hosted same-origin UI
+    // can use this opt-in, never a cross-origin site or a device credential.
+    const requestOrigin = c.req.header('origin');
