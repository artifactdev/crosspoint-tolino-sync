+import { createHash } from 'node:crypto';
+import { cachedEpub } from './bookfusion-epub.js';
+import { tolinoPoint, tolinoXPath } from './tolino-epub.js';
+import { ConnectorOperationError, type Connector, type ConnectorContext, type Credential,
+  type HttpTransport, type Match } from './types.js';
+
+function failure(message: string, retryable = false): never {
+  throw new ConnectorOperationError(message, retryable);
+}
+
+function connection(credential: Credential) {
+  // An operator-configured destination, never a user-controlled server-side fetch URL.
+  const url = new URL(process.env.TOLINO_HELPER_URL ?? 'http://127.0.0.1:8081');
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password ||
+      url.pathname !== '/' || url.search || url.hash) failure('Invalid TOLINO_HELPER_URL');
+  const token = credential.token;
+  if (typeof token !== 'string' || token.length < 32 || /[^\x21-\x7e]/.test(token)) {
+    failure('A valid Tolino helper API key is required');
+  }
+  return { origin: url.origin, headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' } };
+}
+
+function check(status: number): void {
+  if (status >= 200 && status < 300) return;
+  throw new ConnectorOperationError(
+    `Tolino helper request failed (HTTP ${status})`, status === 429 || status >= 500, status === 401
+  );
+}
+
+interface Remote {
+  revision: string;
+  position: { progress: number; position: string; modified: number } | null;
+}
+
+async function remote(credential: Credential, id: string, http: HttpTransport): Promise<Remote> {
+  const { origin, headers } = connection(credential);
+  const res = await http(`${origin}/api/sync-position?id=${encodeURIComponent(id)}`, {
+    method: 'GET', headers, redirect: 'error', signal: AbortSignal.timeout(10_000),
+  });
+  check(res.status);
+  const data = await res.json() as Partial<Remote> | null;
+  if (!data || typeof data.revision !== 'string' || !data.revision) failure('Invalid Tolino cloud revision');
+  const p = data.position;
+  if (p !== null && (!p || typeof p.position !== 'string' || typeof p.progress !== 'number' ||
+      !Number.isFinite(p.progress) || p.progress < 0 || p.progress > 1 || typeof p.modified !== 'number' ||
+      !Number.isFinite(p.modified) || p.modified < 0)) failure('Invalid Tolino reading position');
+  return { revision: data.revision, position: p };
+}
+
+/** Match CrossPoint/KOReader's binary partial MD5; never use filename or fuzzy title matching for position writes. */
+export function tolinoDocumentHash(bytes: Buffer): string {
+  const hash = createHash('md5');
+  for (let i = -1; i < 11; i++) {
+    const offset = i < 0 ? 0 : 1024 * 4 ** i;
+    if (offset < bytes.length) hash.update(bytes.subarray(offset, Math.min(offset + 1024, bytes.length)));
+  }
+  return hash.digest('hex');
+}
+
+async function book(credential: Credential, match: Match, http: HttpTransport, ctx?: ConnectorContext) {
+  if (!match.fromSidecar || !ctx?.document) failure('Tolino sync requires the downloaded book sidecar and binary document matching');
+  const { origin, headers } = connection(credential);
+  return cachedEpub(['tolino', origin, credential.token, match.externalId, ctx.document], async signal => {
+    const res = await http(`${origin}/api/download?id=${encodeURIComponent(match.externalId)}`, {
+      method: 'GET', headers, redirect: 'error', signal,
+    });
+    check(res.status);
+    if (!res.body) failure('Tolino EPUB response has no body');
+    const reader = res.body.getReader(), chunks: Uint8Array[] = [];
+    let size = 0;
+    try {
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        size += value.length;
+        if (size > 200 * 1024 * 1024) failure('Tolino EPUB exceeds 200 MiB');
+        chunks.push(value);
+      }
+    } finally { await reader.cancel(); reader.releaseLock(); }
+    const bytes = Buffer.concat(chunks, size);
+    if (tolinoDocumentHash(bytes) !== ctx.document) failure('Tolino EPUB edition mismatch: use binary matching and the same downloaded EPUB');
+    return { ...res, body: new ReadableStream({ start(controller) { controller.enqueue(bytes); controller.close(); } }) };
+  });
+}
+
+export const tolinoConnector: Connector = {
+  id: 'tolino',
+  displayName: 'Tolino / Thalia (local helper)',
+  tier: 3,
+  capabilities: { read: true, write: true },
+  carries: ['progress', 'finished'],
+  credentialKind: 'token',
+  beta: true,
+  options: [
+    { key: 'progress', label: 'Send reading positions to Tolino', default: false, gates: 'progress' },
+    { key: 'finished', label: 'Send finished reading positions to Tolino', default: false, gates: 'finished' },
+  ],
+  async validate(credential, http) {
+    const { origin, headers } = connection(credential);
+    const res = await http(`${origin}/api/sync-status`, { method: 'GET', headers, redirect: 'error',
+      signal: AbortSignal.timeout(10_000) });
+    check(res.status);
+    const status = await res.json() as { connected?: unknown };
+    return status?.connected === true ? { ok: true, accountLabel: 'Local Tolino Bridge' }
+      : { ok: false, error: 'Sign in on the Tolino helper dashboard first' };
+  },
+  async match() { return null; },
+  async pullProgress(credential, match, http, sinceMs, ctx) {
+    if (!match.fromSidecar) return null;
+    const cloud = await remote(credential, match.externalId, http);
+    if (!cloud.position) return null;
+    const epub = await book(credential, match, http, ctx);
+    const progress = await tolinoXPath(epub, cloud.position.position);
+    return { externalId: match.externalId, percentage: cloud.position.progress, progress,
+      finished: cloud.position.progress === 1, updatedAtMs: cloud.position.modified, furthestReadOnly: true };
+  },
+  async push(credential, match, event, http, ctx) {
+    if (typeof event.progress !== 'string' || typeof event.percentage !== 'number' ||
+        !Number.isFinite(event.percentage) || event.percentage < 0 || event.percentage > 1 ||
+        !Number.isSafeInteger(event.timestamp) || event.timestamp < 0) failure('An exact timestamped reader position is required');
+    const cloud = await remote(credential, match.externalId, http);
+    // Queued events must never undo a newer cloud session, even if it is further back in the book.
+    if (cloud.position && Math.floor(cloud.position.modified / 1000) > event.timestamp) {
+      return { ok: true, note: 'Newer Tolino cloud position retained; pull before continuing' };
+    }
+    const epub = await book(credential, match, http, ctx);
+    const position = await tolinoPoint(epub, event.progress);
+    const { origin, headers } = connection(credential);
+    const body = JSON.stringify({
+      id: match.externalId, revision: cloud.revision, expectedModified: cloud.position?.modified ?? null,
+      position, progress: event.percentage, modified: event.timestamp * 1000,
+    });
+    let res;
+    try {
+      res = await http(`${origin}/api/sync-position`, { method: 'PUT', headers, redirect: 'error',
+        signal: AbortSignal.timeout(120_000), body });
+    } catch (error) {
+      if (!(error instanceof Error)) throw error;
+      failure('Tolino write outcome is unknown; pull before retrying');
+    }
+    if (res.status === 409) return { ok: false, retryable: false, error: 'Tolino conflict: pull cloud position before retrying' };
+    if (res.status < 200 || res.status >= 300) failure(`Tolino write failed (HTTP ${res.status}); pull before retrying`);
+    let result: { synced?: unknown };
+    try { result = await res.json() as { synced?: unknown }; }
+    catch (error) {
+      if (!(error instanceof Error)) throw error;
+      failure('Tolino write response is invalid; pull before retrying');
+    }
+    if (result?.synced !== true) failure('Tolino write not confirmed; pull before retrying');
+    return { ok: true };
+  },
+};
