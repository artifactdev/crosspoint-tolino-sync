@@ -0,0 +1,139 @@
+import { posix } from 'node:path';
+import type { Element, Node } from '@xmldom/xmldom';
+import { epubPosition, withChapter, type Epub } from './bookfusion-epub.js';
+import { ConnectorOperationError } from './types.js';
+
+function invalid(): never {
+  throw new ConnectorOperationError('Tolino position cannot be resolved exactly in the downloaded EPUB', false);
+}
+
+function children(node: Node): Node[] { return Array.from(node.childNodes ?? []); }
+function elements(node: Node): Element[] {
+  return children(node).filter((node): node is Element => node.nodeType === 1);
+}
+function isText(node: Node): boolean { return node.nodeType === 3 || node.nodeType === 4; }
+// RMSDK counts DOM siblings, including formatting whitespace and comments, but not processing instructions.
+function enumerable(node: Node): Node[] { return children(node).filter(node => node.nodeType !== 7); }
+function localName(node: Node): string { return (node as Element).localName ?? ''; }
+const HIDDEN = new Set(['head', 'style', 'script', 'title', 'rp']);
+
+function safePath(value: string): string {
+  let decoded: string;
+  try { decoded = decodeURIComponent(value); } catch { return invalid(); }
+  if (!decoded || decoded.startsWith('/') || decoded.includes('\\') || /[\u0000-\u001f?#]/.test(decoded)) invalid();
+  const normalized = posix.normalize(decoded);
+  if (normalized === '..' || normalized.startsWith('../')) invalid();
+  return normalized;
+}
+
+function fromBytes(value: string, offset: number): number {
+  if (!Number.isSafeInteger(offset) || offset < 0) invalid();
+  let bytes = 0, count = 0;
+  for (const character of value) {
+    if (bytes === offset) return count;
+    bytes += Buffer.byteLength(character);
+    count++;
+    if (bytes > offset) invalid();
+  }
+  return bytes === offset ? count : invalid();
+}
+
+function xpath(html: Element, body: Element, target: Node, index: number, offset: number): string {
+  const path: string[] = [];
+  let current = target;
+  for (; current !== body; current = current.parentNode ?? invalid()) {
+    if (current === html || (current.nodeType !== 1 && !isText(current))) invalid();
+    const parent = current.parentNode ?? invalid();
+    if (isText(current)) {
+      if (current !== target) invalid();
+      const siblings = children(parent).filter(isText);
+      path.unshift(`text()[${siblings.indexOf(current) + 1}].${offset}`);
+    } else {
+      if (HIDDEN.has(localName(current))) invalid();
+      const siblings = elements(parent).filter(node => localName(node) === localName(current));
+      path.unshift(`${localName(current)}[${siblings.indexOf(current as Element) + 1}]`);
+    }
+  }
+  return `/body/DocFragment[${index + 1}]/body` + (path.length ? '/' + path.join('/') : '');
+}
+
+/** RMSDK #point uses one-based DOM children and UTF-8 byte offsets, not CFI steps or percentages. */
+export async function tolinoXPath(epub: Epub, locator: string): Promise<string> {
+  const match = /^([^#]+)#point\(\/1((?:\/[1-9]\d*)+):(\d+)\)$/.exec(locator);
+  if (!match || locator.length > 4096) invalid();
+  const chapter = safePath(match[1]);
+  return withChapter(epub, (opf, _spine, items, opfPath) => {
+    const manifest = elements(opf).find(node => localName(node) === 'manifest') ?? invalid();
+    const found: number[] = [];
+    for (const [index, item] of items.entries()) {
+      const file = elements(manifest).find(node => node.getAttribute('id') === item.getAttribute('idref'));
+      if (!file) invalid();
+      const href = file.getAttribute('href')?.split('#')[0] ?? invalid();
+      const resolved = posix.normalize(posix.join(posix.dirname(opfPath), decodeURIComponent(href)));
+      const alias = posix.normalize(decodeURIComponent(href));
+      if (chapter === resolved || chapter === posix.basename(resolved) ||
+          (!alias.startsWith('../') && chapter === alias)) found.push(index);
+    }
+    return found.length === 1 ? found[0] : invalid();
+  }, ({ html, body, index }) => {
+    let node: Node = html;
+    for (const step of match[2].slice(1).split('/')) {
+      const number = Number(step);
+      if (!Number.isSafeInteger(number)) invalid();
+      node = enumerable(node)[number - 1] ?? invalid();
+    }
+    let offset = fromBytes(node.textContent ?? '', Number(match[3]));
+    if (node.nodeType === 1 && offset > 0) {
+      // Element offsets are measured over descendant text, not an estimated paragraph.
+      const root = node;
+      let found: Node | null = null;
+      for (let current: Node | null = root; current;) {
+        if (isText(current)) {
+          const length = Array.from(current.nodeValue ?? '').length;
+          if (offset <= length) { found = current; break; }
+          offset -= length;
+        }
+        if (current.firstChild) { current = current.firstChild; continue; }
+        while (current !== root && !current.nextSibling) current = current.parentNode!;
+        current = current === root ? null : current.nextSibling;
+      }
+      node = found ?? invalid();
+    }
+    return xpath(html, body, node, index, offset);
+  });
+}
+
+/** Resolve the actual XPath first; translate codepoints to UTF-8 bytes only at the selected text node. */
+export async function tolinoPoint(epub: Epub, progress: string): Promise<string> {
+  await epubPosition(epub, progress);
+  const match = /^\/body\/DocFragment(?:\[(\d+)\])?\/body(?:\/(.*))?$/.exec(progress) ?? invalid();
+  return withChapter(epub, () => Number(match[1] ?? 1) - 1, async ({ html, body, path }) => {
+    let node: Node = body;
+    let offset = 0;
+    for (const part of match[2]?.split('/') ?? []) {
+      const text = /^text\(\)(?:\[(\d+)\])?(?:\.(\d+))?$/.exec(part);
+      if (text) {
+        node = children(node).filter(isText)[Number(text[1] ?? 1) - 1] ?? invalid();
+        offset = Number(text[2] ?? 0);
+      } else {
+        const element = /^([\w:.-]+)(?:\[(\d+)\])?$/.exec(part) ?? invalid();
+        node = elements(node).filter(child => localName(child) === element[1].split(':').pop())[
+          Number(element[2] ?? 1) - 1] ?? invalid();
+        if (HIDDEN.has(localName(node))) invalid();
+      }
+    }
+    const value = Array.from(node.textContent ?? '');
+    if (!Number.isSafeInteger(offset) || offset > value.length) invalid();
+    const bytes = Buffer.byteLength(value.slice(0, offset).join(''));
+    const steps: number[] = [];
+    for (let current = node; current !== html; current = current.parentNode ?? invalid()) {
+      if (!current.parentNode) invalid();
+      steps.unshift(enumerable(current.parentNode).indexOf(current) + 1);
+    }
+    const locator = `${path.split('/').map(encodeURIComponent).join('/')}#point(/1/${steps.join('/')}:${bytes})`;
+    const roundtrip = await tolinoXPath(epub, locator);
+    // Both representations must anchor the same node; do not silently fall back to a percentage.
+    await epubPosition(epub, roundtrip);
+    return locator;
+  });
+}
