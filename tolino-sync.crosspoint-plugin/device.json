{
  "title": "Thalia / Tolino",
  "description": "Sortierte Bibliothek; Suche nach Titel, Autor oder jahr:2024.",
  "config": {"file": "settings.json"},
  "auth": {"type": "none"},
  "browse": {
    "url": "{cfg.helperUrl}/api/catalog",
    "headers": {
      "Authorization": "Bearer {cfg.helperApiKey}",
      "X-Tolino-Mode": "{cfg.mode}",
      "X-Tolino-Transport-Accepted": "{cfg.nativeTransportAccepted}"
    },
    "items": "books",
    "lists": [
      {"title": "Titel A-Z", "url": "{cfg.helperUrl}/api/catalog?sort=title-asc"},
      {"title": "Titel Z-A", "url": "{cfg.helperUrl}/api/catalog?sort=title-desc"},
      {"title": "Autor A-Z", "url": "{cfg.helperUrl}/api/catalog?sort=author-asc"},
      {"title": "Autor Z-A", "url": "{cfg.helperUrl}/api/catalog?sort=author-desc"},
      {"title": "Erscheinungsjahr: neueste zuerst", "url": "{cfg.helperUrl}/api/catalog?sort=year-desc"},
      {"title": "Erscheinungsjahr: aelteste zuerst", "url": "{cfg.helperUrl}/api/catalog?sort=year-asc"},
      {"title": "Ohne Erscheinungsjahr", "url": "{cfg.helperUrl}/api/catalog?year=unknown"}
    ],
    "search": {"url": "{cfg.helperUrl}/api/catalog?q={query}"},
    "page_size": 8,
    "fields": {
      "id": "id",
      "title": "title",
      "author": "author",
      "url": "sidecar",
      "description": "description"
    }
  },
  "download": {
    "url": "{cfg.helperUrl}/api/native-download?id={id}",
    "headers": {
      "Authorization": "Bearer {cfg.helperApiKey}",
      "X-Tolino-Mode": "{cfg.mode}",
      "X-Tolino-Transport-Accepted": "{cfg.nativeTransportAccepted}"
    },
    "dest_dir": "/Books/Tolino",
    "filename": "{title}.epub",
    "skip_existing": true,
    "identity_key": "tolino_id",
    "bulk": {
      "url": "{cfg.helperUrl}/api/catalog?supported=1",
      "title": "Alle fehlenden EPUBs laden",
      "notice": "Alle unterstuetzten EPUBs der gesamten Bibliothek laden, auch ausserhalb der aktuellen Suche/Ansicht. Vorhandene Buecher werden anhand ihrer Tolino-ID uebersprungen; DRM-Buecher sind ausgeschlossen. Lesestaende werden nicht automatisch angewendet. Zurueck bricht ab."
    },
    "sidecar": {"path": "{dest}.meta.json", "body": "{url}"}
  }
}
