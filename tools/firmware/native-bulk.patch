diff --git a/src/network/TolinoPoint.cpp b/src/network/TolinoPoint.cpp
new file mode 100644
index 0000000..b72ecc9
--- /dev/null
+++ b/src/network/TolinoPoint.cpp
@@ -0,0 +1,247 @@
+#include "TolinoPoint.h"
+
+#include <Epub.h>
+#include <FsHelpers.h>
+#include <expat.h>
+
+#include <cstdio>
+#include <map>
+#include <vector>
+
+#include "util/PluginHttp.h"
+
+namespace {
+bool number(const std::string& text, size_t& out) {
+  if (text.empty() || text.size() > 8) return false;
+  out = 0;
+  for (char c : text) {
+    if (c < '0' || c > '9') return false;
+    out = out * 10 + c - '0';
+  }
+  return true;
+}
+
+bool byteOffset(const std::string& text, size_t requested, bool toCloud, size_t& converted) {
+  size_t characters = 0;
+  for (size_t byte = 0;;) {
+    if ((toCloud ? characters : byte) == requested) {
+      converted = toCloud ? byte : characters;
+      return true;
+    }
+    if (byte == text.size()) return false;
+    const unsigned char c = text[byte];
+    const size_t width = c < 0x80 ? 1 : (c & 0xe0) == 0xc0 ? 2 : (c & 0xf0) == 0xe0 ? 3 : 4;
+    byte += width;
+    if (byte > text.size()) return false;
+    ++characters;
+  }
+}
+
+class Scanner : public Print {
+ public:
+  struct Frame {
+    std::string tag, point, xpath;
+    std::map<std::string, size_t> elements;
+    size_t children = 0, texts = 0;
+    bool hidden = false;
+  };
+  XML_Parser parser = nullptr;
+  std::vector<Frame> stack;
+  std::string wanted, found, text;
+  size_t offset = 0, total = 0;
+  bool toCloud = false, invalid = false, rootSeen = false, elementText = false;
+
+  Scanner(std::string wanted, size_t offset, bool toCloud)
+      : wanted(std::move(wanted)), offset(offset), toCloud(toCloud) {
+    parser = XML_ParserCreate(nullptr);
+    if (!parser) {
+      invalid = true;
+      return;
+    }
+    XML_SetUserData(parser, this);
+    XML_SetElementHandler(parser, start, end);
+    XML_SetCharacterDataHandler(parser, characters);
+    XML_SetCommentHandler(parser, comment);
+    XML_SetProcessingInstructionHandler(parser, instruction);
+    XML_SetCdataSectionHandler(parser, boundary, boundary);
+    XML_SetExternalEntityRefHandler(
+        parser, [](XML_Parser, const XML_Char*, const XML_Char*, const XML_Char*, const XML_Char*) -> int {
+          return XML_STATUS_ERROR;
+        });
+  }
+  ~Scanner() override {
+    if (parser) XML_ParserFree(parser);
+  }
+  size_t write(uint8_t c) override { return write(&c, 1); }
+  size_t write(const uint8_t* data, size_t length) override {
+    total += length;
+    if (invalid || total > 2 * 1024 * 1024 ||
+        XML_Parse(parser, reinterpret_cast<const char*>(data), length, false) == XML_STATUS_ERROR) {
+      invalid = true;
+      return 0;
+    }
+    return length;
+  }
+  bool finish() {
+    if (invalid || XML_Parse(parser, "", 0, true) == XML_STATUS_ERROR) return false;
+    flush();
+    return !invalid && rootSeen && !found.empty();
+  }
+  void match(const std::string& point, const std::string& xpath, bool hidden, bool isText) {
+    if (hidden) return;
+    const std::string& candidate = toCloud ? xpath : point;
+    if (candidate == wanted && !isText) {
+      if (offset == 0)
+        found = toCloud ? point + ":0" : xpath;
+      else if (!toCloud)
+        elementText = true;
+      else
+        invalid = true;  // XPath element offsets are not valid reader anchors.
+    }
+  }
+  void flush() {
+    if (text.empty() || stack.empty()) {
+      text.clear();
+      return;
+    }
+    const auto& parent = stack.back();
+    const std::string point = parent.point + "/" + std::to_string(parent.children);
+    const std::string xpath = parent.xpath + "/text()[" + std::to_string(parent.texts) + "]";
+    size_t converted = 0;
+    if (!parent.hidden && ((toCloud ? xpath : point) == wanted || elementText) && found.empty()) {
+      if (byteOffset(text, offset, toCloud, converted))
+        found = toCloud ? point + ":" + std::to_string(converted) : xpath + "." + std::to_string(converted);
+      else if (elementText && offset > text.size())
+        offset -= text.size();
+      else
+        invalid = true;
+    }
+    text.clear();
+  }
+  static Scanner& self(void* p) { return *static_cast<Scanner*>(p); }
+  static void start(void* p, const char* name, const char**) {
+    auto& s = self(p);
+    s.flush();
+    if (s.stack.size() >= 128) {
+      s.invalid = true;
+      return;
+    }
+    std::string tag = name;
+    if (const auto colon = tag.find(':'); colon != std::string::npos) tag.erase(0, colon + 1);
+    Frame f;
+    f.tag = tag;
+    if (s.stack.empty()) {
+      if (s.rootSeen || tag != "html") s.invalid = true;
+      s.rootSeen = true;
+      f.point = "/1";
+    } else {
+      auto& parent = s.stack.back();
+      f.point = parent.point + "/" + std::to_string(++parent.children);
+      const size_t index = ++parent.elements[tag];
+      f.xpath = parent.xpath;
+      if (!f.xpath.empty()) f.xpath += "/" + tag + "[" + std::to_string(index) + "]";
+      if (tag == "body" && parent.tag == "html") f.xpath = "/body";
+      f.hidden = parent.hidden;
+    }
+    f.hidden = f.hidden || tag == "head" || tag == "style" || tag == "script" || tag == "title" || tag == "rp";
+    s.match(f.point, f.xpath, f.hidden, false);
+    s.stack.push_back(std::move(f));
+  }
+  static void end(void* p, const char*) {
+    auto& s = self(p);
+    s.flush();
+    if (s.stack.empty()) {
+      s.invalid = true;
+      return;
+    }
+    if (s.stack.back().point == s.wanted && s.elementText) {
+      if (s.found.empty()) s.invalid = true;
+      s.elementText = false;
+    }
+    s.stack.pop_back();
+  }
+  static void characters(void* p, const char* value, int length) {
+    auto& s = self(p);
+    if (s.stack.empty() || length <= 0) return;
+    if (s.text.empty()) {
+      ++s.stack.back().children;
+      ++s.stack.back().texts;
+    }
+    if (s.text.size() + length > 128 * 1024) {
+      s.invalid = true;
+      return;
+    }
+    s.text.append(value, length);
+  }
+  static void comment(void* p, const char*) {
+    auto& s = self(p);
+    s.flush();
+    if (!s.stack.empty()) ++s.stack.back().children;
+  }
+  static void instruction(void* p, const char*, const char*) { self(p).flush(); }
+  static void boundary(void* p) { self(p).flush(); }
+};
+}  // namespace
+
+namespace tolino {
+bool convertPoint(const std::string& path, const std::string& source, bool toCloud, std::string& destination) {
+  Epub epub(path, "/.crosspoint");
+  epub.setupCacheDir();
+  if (!epub.load(false, true) || source.size() > 4096) return false;
+  int spine = -1;
+  std::string wanted;
+  size_t offset = 0;
+  if (toCloud) {
+    const std::string prefix = "/body/DocFragment[";
+    if (source.rfind(prefix, 0) != 0) return false;
+    const auto close = source.find(']', prefix.size());
+    size_t numberValue;
+    if (close == std::string::npos || !number(source.substr(prefix.size(), close - prefix.size()), numberValue) ||
+        numberValue == 0 || numberValue > static_cast<size_t>(epub.getSpineItemsCount()))
+      return false;
+    spine = numberValue - 1;
+    wanted = source.substr(close + 1);
+    const auto textOffset = wanted.rfind("].");
+    if (textOffset != std::string::npos) {
+      if (!number(wanted.substr(textOffset + 2), offset)) return false;
+      wanted.resize(textOffset + 1);
+    }
+  } else {
+    const auto marker = source.find("#point(");
+    const auto colon = source.rfind(':');
+    if (marker == std::string::npos || colon == std::string::npos || source.back() != ')' ||
+        !number(source.substr(colon + 1, source.size() - colon - 2), offset))
+      return false;
+    const std::string chapter = FsHelpers::normalisePath(FsHelpers::decodeUriEscapes(source.substr(0, marker)));
+    if (chapter.empty() || chapter.front() == '/' || chapter.find("..") != std::string::npos) return false;
+    for (int i = 0; i < epub.getSpineItemsCount(); ++i) {
+      const std::string candidate = epub.getSpineItem(i).href;
+      const auto slash = candidate.rfind('/');
+      if (candidate == chapter || candidate.substr(slash == std::string::npos ? 0 : slash + 1) == chapter) {
+        if (spine != -1) return false;
+        spine = i;
+      }
+    }
+    wanted = source.substr(marker + 7, colon - marker - 7);
+  }
+  if (spine < 0 || wanted.empty()) return false;
+  Scanner scanner(wanted, offset, toCloud);
+  const std::string chapter = epub.getSpineItem(spine).href;
+  if (!epub.readItemContentsToStream(chapter, scanner, 1024) || !scanner.finish()) return false;
+  if (toCloud) {
+    std::string encoded;
+    size_t start = 0;
+    for (;;) {
+      const auto slash = chapter.find('/', start);
+      encoded += pluginhttp::urlEncodeQuery(chapter.substr(start, slash == std::string::npos ? slash : slash - start));
+      if (slash == std::string::npos) break;
+      encoded += '/';
+      start = slash + 1;
+    }
+    destination = encoded + "#point(" + scanner.found + ")";
+  } else {
+    destination = "/body/DocFragment[" + std::to_string(spine + 1) + "]" + scanner.found;
+  }
+  return true;
+}
+}  // namespace tolino
