@@ -0,0 +1,136 @@
+import type { DB } from '../db/db.js';
+import { withTransaction } from '../db/db.js';
+import { nowSeconds } from '../models/sync.js';
+import { parseMetadata, saveDocumentMetadata } from '../routes/kosync.js';
+import { cacheTolinoArchive, tolinoArchive, tolinoConnection, tolinoDocumentHash } from './tolino.js';
+import { decryptCredential, getAccount, getMatch, setAccountStatus } from './store.js';
+import { ConnectorOperationError, type HttpTransport } from './types.js';
+import { fetchTransport } from './registry.js';
+
+const pending = new WeakMap<DB, Map<number, Promise<void>>>();
+
+interface LibraryRow {
+  external_id: string;
+  title: string;
+  document: string | null;
+  status: string;
+  message: string | null;
+}
+
+export function tolinoLibraryStatus(db: DB, userId: number) {
+  const rows = db.prepare('SELECT external_id, title, document, status, message FROM tolino_library WHERE user_id = ?')
+    .all(userId) as unknown as LibraryRow[];
+  return {
+    running: pending.get(db)?.has(userId) ?? false,
+    registered: rows.filter(row => row.status === 'registered').length,
+    skipped: rows.filter(row => row.status === 'skipped').length,
+    errors: rows.filter(row => row.status === 'error').length,
+    notices: rows.filter(row => row.message).map(row => ({ title: row.title, message: row.message })),
+  };
+}
+
+/** Register only verified binary identities. No reader position or cloud write is invented. */
+export function syncTolinoLibrary(db: DB, userId: number, http: HttpTransport = fetchTransport): Promise<void> {
+  let jobs = pending.get(db);
+  if (!jobs) { jobs = new Map(); pending.set(db, jobs); }
+  const existing = jobs.get(userId);
+  if (existing) return existing;
+  const account = getAccount(db, userId, 'tolino');
+  const job = discover(db, userId, http).then(() => {
+    const fresh = getAccount(db, userId, 'tolino');
+    if (fresh && fresh.cred_enc === account?.cred_enc && fresh.status === 'ok') {
+      setAccountStatus(db, userId, 'tolino', 'ok', null);
+    }
+  }, error => {
+    const fresh = getAccount(db, userId, 'tolino');
+    if (fresh && fresh.cred_enc === account?.cred_enc) {
+      setAccountStatus(db, userId, 'tolino', fresh.status, error instanceof Error ? error.message : 'Tolino library registration failed');
+    }
+    throw error;
+  }).finally(() => jobs.delete(userId));
+  jobs.set(userId, job);
+  return job;
+}
+
+async function discover(db: DB, userId: number, http: HttpTransport): Promise<void> {
+  const account = getAccount(db, userId, 'tolino');
+  if (!account?.enabled || account.status !== 'ok') return;
+  const credential = decryptCredential(account);
+  const { origin, headers } = tolinoConnection(credential);
+  const stillLinked = () => {
+    const fresh = getAccount(db, userId, 'tolino');
+    return fresh?.enabled && fresh.status === 'ok' && fresh.cred_enc === account.cred_enc;
+  };
+  const response = await http(origin + '/api/inventory', {
+    method: 'GET', headers, redirect: 'error', signal: AbortSignal.timeout(30_000),
+  });
+  if (response.status !== 200) throw new ConnectorOperationError(`Tolino library inventory failed (HTTP ${response.status})`, true);
+  const data = await response.json() as { PublicationInventory?: { ebook?: unknown; edata?: unknown } };
+  const inventory = data?.PublicationInventory;
+  if (!Array.isArray(inventory?.ebook) || !Array.isArray(inventory?.edata)) {
+    throw new Error('Invalid Tolino library inventory; registration stopped');
+  }
+  const items = [...inventory.ebook, ...inventory.edata] as {
+    epubMetaData?: { identifier?: unknown; title?: unknown; author?: { name?: unknown }[];
+      deliverable?: { contentFormat?: unknown; contentEncrypted?: unknown; contentProtectionType?: unknown }[];
+      contentProtectionType?: unknown; protectionType?: unknown };
+    contentProtectionType?: unknown;
+  }[];
+  const seen = new Set<string>();
+  const save = db.prepare(`INSERT INTO tolino_library (user_id, external_id, title, document, status, message, updated_at)
+    VALUES (?, ?, ?, ?, ?, ?, ?) ON CONFLICT(user_id, external_id) DO UPDATE SET
+    title=excluded.title, document=excluded.document, status=excluded.status, message=excluded.message, updated_at=excluded.updated_at`);
+  for (const item of items) {
+    if (!stillLinked()) return;
+    const meta = item?.epubMetaData;
+    if (typeof meta?.identifier !== 'string' || !meta.identifier.trim() ||
+        typeof meta.title !== 'string' || !meta.title.trim()) {
+      throw new Error('Tolino inventory entry has no valid identifier/title');
+    }
+    const id = meta.identifier, title = meta.title;
+    if (seen.has(id)) continue;
+    seen.add(id);
+    const deliverable = meta.deliverable?.[0];
+    const protections = [item.contentProtectionType, meta.contentProtectionType, meta.protectionType,
+      deliverable?.contentProtectionType];
+    const supported = String(deliverable?.contentFormat).toLowerCase() === 'application/epub+zip' &&
+      deliverable?.contentEncrypted === false &&
+      protections.every(value => ['', 'UNPROTECTED', 'WATERMARK', 'WATERMARKV1', 'NONE'].includes(String(value ?? '').toUpperCase()));
+    if (!supported) {
+      save.run(userId, id, title, null, 'skipped', 'DRM-protected or unsupported format; EPUB registration unavailable', nowSeconds());
+      continue;
+    }
+    try {
+      const previous = db.prepare('SELECT document FROM tolino_library WHERE user_id=? AND external_id=? AND status=?')
+        .get(userId, id, 'registered') as { document: string } | undefined;
+      let document = previous?.document;
+      if (!document) {
+        const bytes = await tolinoArchive(credential, id, http);
+        document = tolinoDocumentHash(bytes);
+        await cacheTolinoArchive(credential, id, document, bytes);
+      }
+      if (!stillLinked()) return;
+      const match = getMatch(db, userId, 'tolino', document);
+      if (match?.external_id && match.external_id !== id && ['manual', 'sidecar'].includes(match.source)) {
+        throw new Error('Existing exact book match conflicts with this binary EPUB; registration needs review');
+      }
+      const metadata = parseMetadata({ title, authors: (meta.author ?? []).map(author => author.name)
+        .filter((name): name is string => typeof name === 'string').join(', '), tolino_id: id });
+      if (!metadata) throw new Error('Tolino metadata cannot be registered');
+      withTransaction(db, () => {
+        saveDocumentMetadata(db, userId, document, metadata, nowSeconds());
+        save.run(userId, id, title, document, 'registered', null, nowSeconds());
+      });
+    } catch (error) {
+      if (!stillLinked()) return;
+      const message = error instanceof Error ? error.message : 'Tolino registration failed';
+      console.error(JSON.stringify({ msg: 'Tolino library book registration failed', user_id: userId, title, error: message }));
+      save.run(userId, id, title, null, 'error', message, nowSeconds());
+    }
+  }
+  if (!stillLinked()) return;
+  // Removed cloud items cease discovery, without deleting their existing reading data.
+  for (const row of db.prepare('SELECT external_id FROM tolino_library WHERE user_id=?').all(userId)) {
+    if (!seen.has(String(row.external_id))) db.prepare('DELETE FROM tolino_library WHERE user_id=? AND external_id=?').run(userId, row.external_id);
+  }
+}
