+void PluginCatalogActivity::confirmDownloadAll() {
+  DetailsSpec spec;
+  spec.header = catalogTitle;
+  spec.title = bulkTitle;
+  spec.description = bulkNotice;
+  spec.actionLabel = tr(STR_FETCH);
+  auto confirmation = makeUniqueNoThrow<DetailsActivity>(renderer, mappedInput, std::move(spec));
+  if (!confirmation) {
+    fail(StrId::STR_MEMORY_ERROR);
+    return;
+  }
+  startActivityForResult(std::move(confirmation), [this](const ActivityResult& result) {
+    if (!result.isCancelled) downloadAll();
+  });
+}
+
+void PluginCatalogActivity::downloadAll() {
+  bulkRunning = true;
+  bulkDownloaded = bulkSkipped = 0;
+  page = 1;
+  beginLoading();
+  if (!fetchBrowseResponse()) {
+    bulkRunning = false;
+    return;
+  }
+  HttpDownloader::DownloadError result = HttpDownloader::OK;
+  beginDownload(bulkTitle);
+  for (;;) {
+    if (!parseBrowseResponse()) {
+      bulkRunning = false;
+      return;
+    }
+    const bool more = hasMore;
+    std::vector<Item> batch;
+    {
+      RenderLock lock;
+      releaseRows();
+      std::vector<fui::ListItem>().swap(rowItems);
+      batch.swap(items);
+    }
+    for (const auto& item : batch) {
+      mappedInput.update(true);
+      if (mappedInput.wasReleased(MappedInputManager::Button::Back)) cancelDownload = true;
+      if (cancelDownload) {
+        result = HttpDownloader::ABORTED;
+        break;
+      }
+      statusMessage = std::to_string(bulkDownloaded) + " " + tr(STR_BULK_DOWNLOADED) + ", " +
+                      std::to_string(bulkSkipped) + " " + tr(STR_BULK_SKIPPED) + "\n" + item.title;
+      requestUpdateAndWait();
+      result = downloadBook(item);
+      if (result != HttpDownloader::OK) break;
+      if (lastDownloadSkipped)
+        ++bulkSkipped;
+      else
+        ++bulkDownloaded;
+      LOG_INF("PCAT", "Bulk progress: %u downloaded, %u skipped", static_cast<unsigned>(bulkDownloaded),
+              static_cast<unsigned>(bulkSkipped));
+    }
+    if (result != HttpDownloader::OK || !more) break;
+    if (++page > 1000) {
+      LOG_ERR("PCAT", "Bulk catalog exceeded 1000 pages");
+      result = HttpDownloader::FILE_ERROR;
+      break;
+    }
+    if (browsePaging() != plugincatalogpaging::Paging::Static) {
+      session = makeUniqueNoThrow<freeink::SecureHttpClient>();
+      if (!session) {
+        bulkRunning = false;
+        fail(StrId::STR_MEMORY_ERROR);
+        return;
+      }
+      if (!fetchBrowseResponse()) {
+        bulkRunning = false;
+        return;
+      }
+    }
+    state = State::DOWNLOADING;
+  }
+  bulkRunning = false;
+  session.reset();
+  // Restore the ordinary catalog, never leave the bulk-only response as the visible list.
+  page = 1;
+  session = makeUniqueNoThrow<freeink::SecureHttpClient>();
+  if (!session) {
+    fail(StrId::STR_MEMORY_ERROR);
+    return;
+  }
+  if (!fetchBrowseResponse() || !parseBrowseResponse()) return;
+  statusMessage = std::to_string(bulkDownloaded) + " " + tr(STR_BULK_DOWNLOADED) + ", " + std::to_string(bulkSkipped) +
+                  " " + tr(STR_BULK_SKIPPED);
+  LOG_INF("PCAT", "Bulk finished: %s", statusMessage.c_str());
+  finishDownload(result);
+}
