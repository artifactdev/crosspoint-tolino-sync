@@ -0,0 +1,44 @@
+// @vitest-environment jsdom
+import { beforeEach, expect, it, vi } from 'vitest'
+import { JSDOM } from 'jsdom'
+
+vi.mock('@tauri-apps/plugin-http', () => ({ fetch: vi.fn() }))
+const fetchMock = vi.fn()
+vi.stubGlobal('fetch', fetchMock)
+vi.stubGlobal('location', new URL('http://sync.test/reading/app/'))
+vi.stubGlobal('localStorage', new JSDOM('', { url: 'http://sync.test' }).window.localStorage)
+const { api, webLogin } = await import('./api.js')
+const response = (data, status = 200) => ({ ok: status === 200, status, json: async () => data })
+
+beforeEach(() => {
+  fetchMock.mockReset()
+  localStorage.clear()
+})
+
+it('bootstraps the same hosted server without receiving or saving a device credential', async () => {
+  fetchMock.mockResolvedValueOnce(response({ enabled: true, username: 'reader' }))
+  const session = await webLogin()
+  expect(session).toEqual({ server: 'http://sync.test/reading', username: 'reader', webAuth: true })
+  expect(fetchMock).toHaveBeenCalledWith('http://sync.test/reading/auth/web-access', {
+    cache: 'no-store', credentials: 'omit', headers: { 'x-crosspoint-web': '1' },
+  })
+  expect(localStorage.length).toBe(0)
+  fetchMock.mockResolvedValueOnce(response({ goals: [] }))
+  await api.readingGoals(session)
+  const init = fetchMock.mock.calls[1][1]
+  expect(init.headers['x-crosspoint-web']).toBe('1')
+  expect(init.headers).not.toHaveProperty('x-auth-user')
+  expect(init.headers).not.toHaveProperty('x-auth-key')
+})
+
+it('retains the login screen when passwordless access is disabled', async () => {
+  fetchMock.mockResolvedValueOnce(response({ enabled: false }))
+  expect(await webLogin()).toBeNull()
+})
+
+it('reports server configuration and network errors rather than pretending to log in', async () => {
+  fetchMock.mockResolvedValueOnce(response({ message: 'Configured user does not exist' }, 409))
+  await expect(webLogin()).rejects.toThrow('Configured user does not exist')
+  fetchMock.mockRejectedValueOnce(new TypeError('Network unavailable'))
+  await expect(webLogin()).rejects.toThrow('Network unavailable')
+})
