  */
+export function passwordlessWebAuth(db: DB, username?: string, origin?: string): MiddlewareHandler<AppEnv> {
+  if (username && (!origin || new URL(origin).origin !== origin || !/^https?:\/\//.test(origin))) {
+    throw new Error('WEB_AUTH_ORIGIN must be the exact browser-visible HTTP(S) Sync origin');
