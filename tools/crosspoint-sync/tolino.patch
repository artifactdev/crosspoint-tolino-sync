+  expect(result.ok).toBe(true);
+  expect(JSON.parse(fake.calls.find(call => call.method === 'PUT')!.body!)).toEqual({
+    id: 'fixture-book', revision: 'r1', expectedModified: 100000,
+    position: point, progress: 0.4, modified: 200000,
+  });
+  const conflict: HttpTransport = async (url, init) => init.method === 'PUT'
+    ? { status: 409, json: async () => null, text: async () => '' } : fake.http(url, init);
+  expect(await tolinoConnector.push(credential, match, {
+    kind: 'progress', timestamp: 200, percentage: 0.4, progress: xpath,
+  }, conflict, context(tolinoDocumentHash(bytes)))).toMatchObject({ ok: false, retryable: false });
+});
+it('does not overwrite a newer cloud session with a delayed reader event', async () => {
