+});
+
+function transport(bytes = archive(), modified = 100000) {
+  const calls: { url: string; method: string; body?: string }[] = [];
+  const http: HttpTransport = async (url, init) => {
+    calls.push({ url, method: init.method, body: init.body });
+    expect(init.redirect).toBe('error');
+    expect(init.headers?.authorization).toBe(`Bearer ${credential.token}`);
+    const path = new URL(url).pathname;
+    if (path === '/api/download') return { status: 200, json: async () => null, text: async () => '',
+      body: new ReadableStream({ start(c) { c.enqueue(bytes); c.close(); } }) };
+    if (path === '/api/sync-position') return { status: 200, text: async () => '',
+      json: async () => init.method === 'PUT' ? { synced: true } :
+        { revision: 'r1', position: { position: point, progress: 0.35, modified } } };
+    throw new Error('Unexpected helper request');
+  };
+  return { http, calls };
+}
+
+it('pulls the exact cloud XPath only for a verified binary EPUB and sidecar match', async () => {
+  const bytes = archive(), fake = transport(bytes);
+  const ctx = context(tolinoDocumentHash(bytes));
+  const change = await tolinoConnector.pullProgress!(credential, match, fake.http, 0, ctx);
+  expect(change).toMatchObject({ progress: xpath, percentage: 0.35, updatedAtMs: 100000 });
+  await expect(tolinoConnector.pullProgress!(credential, match, fake.http, 0,
+    context('f'.repeat(32)))).rejects.toThrow('edition mismatch');
+  expect(await tolinoConnector.pullProgress!(credential, { ...match, fromSidecar: false }, fake.http, 0, ctx)).toBeNull();
+});
+it('sends one conflict-checked exact point and never retries a 409', async () => {
+  const bytes = archive(), fake = transport(bytes);
