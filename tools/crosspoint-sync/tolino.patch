+      || (fetchSite !== undefined && fetchSite !== 'same-origin')
+      || (requestOrigin !== undefined && requestOrigin !== origin)
+      || (!['GET', 'HEAD'].includes(c.req.method) && requestOrigin !== origin && fetchSite !== 'same-origin')) {
+      return c.json({ message: 'Passwordless web access requires a same-origin request' }, 403);
+    }
+    const user = db.prepare('SELECT id, username FROM users WHERE username = ?').get(username) as AuthedUser | undefined;
+    if (!user) return c.json({ message: 'Configured WEB_AUTH_USER does not exist; create the Sync account with normal authentication first' }, 409);
+    c.set('user', user);
+    c.header('Cache-Control', 'no-store');
+    return next();
+  };
