+    { epubMetaData: { identifier: 'fixture-book', title: 'Cloud book', author: [{ name: 'Author' }],
+      deliverable: [{ contentFormat: 'application/epub+zip', contentEncrypted: false }] } },
+    { epubMetaData: { identifier: 'unread', title: 'Unread book',
+      deliverable: [{ contentFormat: 'application/epub+zip', contentEncrypted: false }] } },
+    { epubMetaData: { identifier: 'drm', title: 'Protected book',
+      deliverable: [{ contentFormat: 'application/epub+zip', contentEncrypted: true }] } },
+    { epubMetaData: { identifier: 'broken', title: 'Broken book',
+      deliverable: [{ contentFormat: 'application/epub+zip', contentEncrypted: false }] } },
+  ];
+  const http: HttpTransport = async (url, init) => {
+    calls.push({ url, method: init.method, body: init.body });
+    const parsed = new URL(url), id = parsed.searchParams.get('id');
+    if (parsed.pathname === '/api/sync-status') return { status: 200, text: async () => '', json: async () => ({ connected: true }) };
+    if (parsed.pathname === '/api/inventory') return { status: 200, text: async () => '',
+      json: async () => ({ PublicationInventory: { ebook: inventory, edata: [] } }) };
+    if (parsed.pathname === '/api/download' && id === 'broken') {
+      return { status: 503, text: async () => '', json: async () => null };
+    }
+    if (parsed.pathname === '/api/download' && (id === 'unread' || id === 'new-book')) {
+      const bytes = archive();
+      // Alter the ZIP archive comment, preserving every XML entry while changing binary identity.
+      bytes.writeUInt16LE(id.length, bytes.length - 2);
+      return { status: 200, text: async () => '', json: async () => null,
+        body: new ReadableStream({ start(c) { c.enqueue(Buffer.concat([bytes, Buffer.from(id)])); c.close(); } }) };
+    }
+    if (parsed.pathname === '/api/sync-position' && (id === 'unread' || id === 'new-book')) return {
+      status: 200, text: async () => '', json: async () => ({ revision: 'r1', position: null }),
+    };
+    return fake.http(url, init);
+  };
+  return { http, calls, inventory };
+}
