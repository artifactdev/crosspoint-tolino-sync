new file mode 100644
index 0000000..d90e3b7
--- /dev/null
+++ b/src/network/TolinoDirect.cpp
@@ -0,0 +1,411 @@
+#include "TolinoDirect.h"
+
+#include <HalStorage.h>
+#include <Logging.h>
+#include <TrustedTime.h>
+#include <base64.h>
+
+#include <cmath>
+#include <ctime>
+#include <map>
+
+#include "HttpDownloader.h"
+#include "KOReaderDocumentId.h"
+#include "TolinoPoint.h"
+#include "util/PluginHttp.h"
+
+namespace {
+std::string lastError;
+std::string accessToken, activeRefresh, hardwareId;
+std::map<std::string, std::string> verifiedBooks;
+unsigned long tokenAt = 0, tokenLifetime = 0;
+constexpr const char* BOSH = "https://bosh.pageplace.de/bosh/rest";
+constexpr size_t MAX_JSON = 256 * 1024;
+
+bool fail(const std::string& message) {
+  lastError = message;
+  LOG_ERR("TOLINO", "%s", message.c_str());
+  return false;
+}
+
+bool readJson(const std::string& path, JsonDocument& doc, size_t limit = 16384) {
+  std::string raw;
+  return Storage.readFileToString("TOLINO", path, limit, raw) && deserializeJson(doc, raw) == DeserializationError::Ok;
+}
+
+bool saveSession(JsonDocument& doc) {
+  const std::string temporary = std::string(tolino::SESSION_PATH) + ".tmp";
+  HalFile file;
+  if (!Storage.openFileForWrite("TOLINO", temporary, file)) return fail("Cannot persist Tolino session.");
+  const size_t size = measureJson(doc);
+  const bool written = serializeJson(doc, file) == size;
+  file.flush();
+  file.close();
+  const std::string backup = std::string(tolino::SESSION_PATH) + ".bak";
+  if (!written) {
+    Storage.remove(temporary.c_str());
+    return fail("Cannot save rotated Tolino session; reconnect before continuing.");
+  }
+  if (Storage.exists(backup.c_str()) && !Storage.remove(backup.c_str()))
+    return fail("Cannot remove stale Tolino session backup.");
+  if (!Storage.rename(tolino::SESSION_PATH, backup.c_str()))
+    return fail("Cannot back up Tolino session; write refused.");
+  if (!Storage.rename(temporary.c_str(), tolino::SESSION_PATH)) {
+    if (!Storage.rename(backup.c_str(), tolino::SESSION_PATH))
+      return fail("Cannot restore Tolino session backup; run setup again.");
+    return fail("Cannot replace Tolino session; run setup again.");
+  }
+  if (!Storage.remove(backup.c_str())) return fail("Cannot remove old Tolino session backup.");
+  return true;
+}
+
+std::string endpoint(const std::string& url) {
+#ifdef SIMULATOR
+  const char* origin = getenv("TOLINO_SIM_ORIGIN");
+  if (origin && std::string(origin).rfind("http://127.0.0.1:", 0) == 0) {
+    if (url.rfind(BOSH, 0) == 0) return std::string(origin) + url.substr(std::string(BOSH).size());
+    if (url == "https://www.thalia.de/auth/oauth2/token") return std::string(origin) + "/token";
+  }
+#endif
+  return url;
+}
+
+bool decodeResponse(int status, const String& raw, JsonDocument& doc) {
+  if (status != 200) return fail("Tolino request failed (HTTP " + std::to_string(status) + ").");
+  if (deserializeJson(doc, raw) != DeserializationError::Ok) return fail("Invalid or oversized Tolino response.");
+  return true;
+}
+
+bool token(bool force = false) {
+  JsonDocument session;
+  if (!readJson(tolino::SESSION_PATH, session) || session["transportAccepted"] != true ||
+      !session["hardwareId"].is<const char*>() || !session["refreshToken"].is<const char*>())
+    return fail("Run the local Tolino setup and accept the SD/transport warning.");
+  const std::string refresh = session["refreshToken"].as<std::string>();
+  const std::string hardware = session["hardwareId"].as<std::string>();
+  if (refresh.empty() || hardware.empty() || refresh.find_first_of("\r\n") != std::string::npos ||
+      hardware.find_first_of("\r\n") != std::string::npos)
+    return fail("Invalid Tolino session; run setup again.");
+  if (!force && refresh == activeRefresh && hardware == hardwareId && !accessToken.empty() &&
+      millis() - tokenAt < tokenLifetime)
+    return true;
+  String raw;
+  const int status =
+      pluginhttp::request(nullptr, endpoint("https://www.thalia.de/auth/oauth2/token"), "POST",
+                          "client_id=webreader&grant_type=refresh_token&scope=SCOPE_BOSH&refresh_token=" +
+                              pluginhttp::urlEncodeQuery(refresh),
+                          {{"Content-Type", "application/x-www-form-urlencoded"}}, raw, 16384);
+  JsonDocument response;
+  if (!decodeResponse(status, raw, response)) return false;
+  if (!response["access_token"].is<const char*>() || !response["expires_in"].is<unsigned long>() ||
+      response["expires_in"].as<unsigned long>() <= 60)
+    return fail("Invalid token response; run Tolino setup again.");
+  accessToken = response["access_token"].as<std::string>();
+  if (accessToken.empty() || accessToken.find_first_of("\r\n") != std::string::npos ||
+      (response["refresh_token"].is<const char*>() && response["refresh_token"].as<std::string>().empty()))
+    return fail("Invalid token response; session not saved.");
+  hardwareId = hardware;
+  if (response["refresh_token"].is<const char*>()) session["refreshToken"] = response["refresh_token"];
+  if (!saveSession(session)) {
+    accessToken.clear();
+    return false;
+  }
+  activeRefresh = session["refreshToken"].as<std::string>();
+  tokenAt = millis();
+  tokenLifetime = std::min(response["expires_in"].as<unsigned long>() - 60, 86400UL) * 1000UL;
+  return true;
+}
+
+bool api(const std::string& path, const char* method, const std::string& body, JsonDocument& response) {
+  if (!token()) return false;
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    String raw;
+    const int status = pluginhttp::request(nullptr, endpoint(std::string(BOSH) + path), method, body,
+                                           {{"t_auth_token", accessToken},
+                                            {"hardware_id", hardwareId},
+                                            {"reseller_id", "3"},
+                                            {"client_type", "TOLINO_WEBREADER"},
+                                            {"client_version", "4.4.1"},
+                                            {"Content-Type", "application/json"},
+                                            {"Accept", "application/json"}},
+                                           raw, MAX_JSON);
+    if ((status == 401 || status == 403) && attempt == 0) {
+      if (!token(true)) return false;
+      continue;
+    }
+    return decodeResponse(status, raw, response);
+  }
+  return fail("Tolino session expired; run local setup again.");
+}
+
+bool supported(JsonVariantConst book) {
+  const auto meta = book["epubMetaData"];
+  const auto deliverable = meta["deliverable"][0];
+  if (deliverable["contentFormat"] != "application/epub+zip") return false;
+  if (!deliverable["contentEncrypted"].isNull() && deliverable["contentEncrypted"] != false) return false;
+  for (JsonVariantConst value : {book["contentProtectionType"], meta["contentProtectionType"], meta["protectionType"],
+                                 deliverable["contentProtectionType"]}) {
+    std::string protection = value.as<std::string>();
+    for (char& c : protection) c = toupper(static_cast<unsigned char>(c));
+    if (!value.isNull() && !protection.empty() && protection != "NONE" && protection != "UNPROTECTED" &&
+        protection != "WATERMARK" && protection != "WATERMARKV1")
+      return false;
+  }
+  return true;
+}
+
+bool inventory(JsonDocument& doc) {
+  if (!api("/inventory/delta?strip=true", "GET", "", doc)) return false;
+  if (!doc["PublicationInventory"]["ebook"].is<JsonArray>() || !doc["PublicationInventory"]["edata"].is<JsonArray>())
+    return fail("Unrecognized Tolino inventory.");
+  return true;
+}
+
+std::string pointer(const std::string& value) {
+  std::string result;
+  for (char c : value) result += c == '~' ? "~0" : c == '/' ? "~1" : std::string(1, c);
+  return result;
+}
+
+struct Cloud {
+  std::string revision, slot, bookmarkRevision, position;
+  double percentage = 0, modified = 0;
+  bool exists = false;
+};
+
+bool decodeCloud(const JsonDocument& doc, const std::string& publication, Cloud& result) {
+  if (!doc["revision"].is<const char*>() || !doc["patches"].is<JsonArrayConst>())
+    return fail("Unrecognized Tolino reading-state response.");
+  result = Cloud{};
+  result.revision = doc["revision"].as<std::string>();
+  if (result.revision.empty()) return fail("Missing Tolino cloud revision.");
+  const std::string parent = "/publications/" + pointer(publication);
+  const std::string prefix = parent + "/bookmark/";
+  std::map<std::string, JsonVariantConst> slots;
+  for (JsonVariantConst patch : doc["patches"].as<JsonArrayConst>()) {
+    const std::string path = patch["path"].as<std::string>();
+    const std::string op = patch["op"].as<std::string>();
+    if (op != "add" && op != "replace" && op != "remove") return fail("Unknown Tolino patch operation.");
+    if (path == "/publications" || path == parent || path == parent + "/bookmark") {
+      if (op != "remove") return fail("Unsupported Tolino bookmark snapshot.");
+      slots.clear();
+    } else if (path.rfind(prefix, 0) == 0) {
+      if (path.substr(prefix.size()).find('/') != std::string::npos) return fail("Invalid Tolino bookmark path.");
+      if (op == "remove")
+        slots.erase(path);
+      else
+        slots[path] = patch["value"];
+    }
+  }
+  for (const auto& entry : slots) {
+    const auto value = entry.second;
+    const double modified = value["modified"].as<double>(), percentage = value["progress"].as<double>();
+    if (!value["modified"].is<double>() || !value["progress"].is<double>() || !std::isfinite(modified) ||
+        !std::isfinite(percentage) || modified < 0 || percentage < 0 || percentage > 1 ||
+        !value["position"].is<const char*>())
+      return fail("Invalid Tolino bookmark.");
+    if (!result.exists || modified > result.modified) {
+      result.exists = true;
+      result.slot = entry.first;
+      result.bookmarkRevision = value["revision"].as<std::string>();
+      result.modified = modified;
+      result.percentage = percentage;
+      result.position = value["position"].as<std::string>();
+    }
+  }
+  return true;
+}
+
+bool cloud(const std::string& publication, Cloud& result) {
+  JsonDocument doc;
+  return api("/sync-data?paths=publications", "PATCH", "{\"revision\":null,\"patches\":[]}", doc) &&
+         decodeCloud(doc, publication, result);
+}
+
+bool identity(const std::string& path, std::string& id, std::string& publication) {
+  JsonDocument doc;
+  if (!readJson(path + ".meta.json", doc, 2048) || !doc["tolino_identifier"].is<const char*>() ||
+      !doc["tolino_publication_id"].is<const char*>())
+    return fail("Missing Tolino book identity; use the original downloaded EPUB and sidecar.");
+  id = doc["tolino_identifier"].as<std::string>();
+  publication = doc["tolino_publication_id"].as<std::string>();
+  return !id.empty() && !publication.empty();
+}
+
+bool verifyBook(const std::string& path, const std::string& id) {
+  const std::string hash = KOReaderDocumentId::calculate(path);
+  if (hash.empty() || !token()) return fail("Cannot verify Tolino EPUB identity.");
+  const std::string key = hardwareId + "\n" + id + "\n" + path;
+  const auto cached = verifiedBooks.find(key);
+  if (cached != verifiedBooks.end() && cached->second == hash) return true;
+  std::string url;
+  if (!tolino::downloadUrl(id, url)) return false;
+  constexpr const char* temporary = "/.crosspoint/tolino-edition-check.epub";
+  if (HttpDownloader::downloadToFile(url, temporary) != HttpDownloader::OK) {
+    Storage.remove(temporary);
+    return fail("Cannot verify cloud EPUB edition; no reading position changed.");
+  }
+  const std::string remoteHash = KOReaderDocumentId::calculate(temporary);
+  const bool removed = Storage.remove(temporary);
+  if (!removed) return fail("Cannot clean up Tolino edition-check file.");
+  if (hash != remoteHash) return fail("Tolino EPUB edition mismatch; position sync refused.");
+  if (verifiedBooks.size() >= 16) verifiedBooks.clear();
+  verifiedBooks[key] = hash;
+  return true;
+}
+}  // namespace
+
+namespace tolino {
+bool configured() {
+  return Storage.exists(SESSION_PATH) || Storage.exists((std::string(SESSION_PATH) + ".bak").c_str()) ||
+         Storage.exists((std::string(SESSION_PATH) + ".tmp").c_str());
+}
+bool ownsBook(const std::string& path) {
+  if (!configured()) return false;
+  JsonDocument doc;
+  return readJson(path + ".meta.json", doc, 2048) && doc["tolino_identifier"].is<const char*>();
+}
+const std::string& error() { return lastError; }
+
+bool catalog(const char* destination, bool supportedOnly) {
+  JsonDocument source;
+  if (!inventory(source)) return false;
+  JsonDocument reading;
+  if (!api("/sync-data?paths=publications", "PATCH", "{\"revision\":null,\"patches\":[]}", reading)) return false;
+  JsonDocument result;
+  JsonArray books = result["books"].to<JsonArray>();
+  std::map<std::string, bool> seen;
+  for (const char* collection : {"ebook", "edata"}) {
+    for (JsonVariantConst book : source["PublicationInventory"][collection].as<JsonArrayConst>()) {
+      const auto meta = book["epubMetaData"];
+      const std::string id = meta["identifier"].as<std::string>(), title = meta["title"].as<std::string>();
+      if (id.empty() || title.empty()) return fail("Cloud book identity/title missing.");
+      if (seen.count(id)) continue;
+      seen[id] = true;
+      const bool allowed = supported(book);
+      if (supportedOnly && !allowed) continue;
+      const std::string publication = book["publicationId"].is<const char*>() ? book["publicationId"].as<std::string>()
+                                      : meta["publicationId"].is<const char*>()
+                                          ? meta["publicationId"].as<std::string>()
+                                          : id;
+      JsonDocument sidecar;
+      sidecar["tolino_identifier"] = id;
+      sidecar["tolino_publication_id"] = publication;
+      sidecar["tolino_id"] = id;
+      std::string serialized;
+      serializeJson(sidecar, serialized);
+      JsonObject row = books.add<JsonObject>();
+      row["id"] = id;
+      row["title"] = title + (allowed ? "" : " [DRM / unsupported]");
+      std::string author;
+      for (JsonVariantConst a : meta["author"].as<JsonArrayConst>()) {
+        if (!author.empty()) author += ", ";
+        author += a["name"].as<std::string>();
+      }
+      row["author"] = author;
+      row["sidecar"] = serialized;
+      Cloud position;
+      if (!decodeCloud(reading, publication, position)) return false;
+      std::string description = position.exists ? "Tolino Cloud: " + std::to_string(position.percentage * 100) + "%.\n"
+                                                : "No Tolino cloud position yet.\n";
+      description += allowed ? "Direct cloud EPUB. Sync Progress reads/writes Tolino directly."
+                             : "Unsupported format or DRM; no download.";
+      row["description"] = description;
+    }
+  }
+  HalFile file;
+  if (!Storage.openFileForWrite("TOLINO", destination, file)) return fail("Cannot save native Tolino catalog.");
+  const bool ok = serializeJson(result, file) == measureJson(result);
+  file.flush();
+  file.close();
+  return ok || fail("Incomplete native Tolino catalog write.");
+}
+
+bool downloadUrl(const std::string& identifier, std::string& url) {
+  JsonDocument source;
+  if (!inventory(source)) return false;
+  bool found = false;
+  for (const char* collection : {"ebook", "edata"}) {
+    for (JsonVariantConst book : source["PublicationInventory"][collection].as<JsonArrayConst>()) {
+      if (book["epubMetaData"]["identifier"] == identifier) {
+        if (!supported(book)) return fail("Unsupported EPUB or DRM; download refused.");
+        found = true;
+      }
+    }
+  }
+  if (!found) return fail("Book is not in the signed-in Tolino library.");
+  const std::string encoded = pluginhttp::urlEncodeQuery(base64::encode(identifier.c_str()).c_str());
+  JsonDocument doc;
+  if (!api("/cloud/downloadinfo/" + encoded + "/" + encoded + "/type/external-download", "GET", "", doc)) return false;
+  if (doc["DownloadInfo"]["format"] != "application/epub+zip") return fail("Tolino did not offer an EPUB.");
+  url = doc["DownloadInfo"]["contentUrl"].as<std::string>();
+  if (url.rfind("https://", 0) != 0 || url.find('@') != std::string::npos ||
+      url.find_first_of("\r\n") != std::string::npos)
+    return fail("Unsafe Tolino download URL.");
+#ifdef SIMULATOR
+  const char* origin = getenv("TOLINO_SIM_ORIGIN");
+  if (origin && std::string(origin).rfind("http://127.0.0.1:", 0) == 0 &&
+      url.rfind("https://tolino-fixture.invalid/", 0) == 0)
+    url = std::string(origin) + url.substr(std::string("https://tolino-fixture.invalid").size());
+#endif
+  return true;
+}
+
+KOReaderSyncClient::Error pull(const std::string& path, KOReaderProgress& progress) {
+  std::string id, publication;
+  Cloud state;
+  if (!identity(path, id, publication) || !cloud(publication, state)) return KOReaderSyncClient::SERVER_ERROR;
+  if (!state.exists) return KOReaderSyncClient::NOT_FOUND;
+  if (!verifyBook(path, id)) return KOReaderSyncClient::SERVER_ERROR;
+  if (!tolino::convertPoint(path, state.position, false, progress.progress))
+    return fail("Cloud position cannot be mapped exactly in this EPUB."), KOReaderSyncClient::JSON_ERROR;
+  progress.percentage = state.percentage;
+  progress.timestamp = static_cast<int64_t>(state.modified / 1000);
+  progress.device = "Tolino Cloud";
+  return KOReaderSyncClient::OK;
+}
+
+KOReaderSyncClient::Error push(const std::string& path, const KOReaderProgress& progress) {
+  std::string id, publication, point;
+  Cloud before;
+  if (!identity(path, id, publication) || !cloud(publication, before)) return KOReaderSyncClient::SERVER_ERROR;
+  if (!verifyBook(path, id)) return KOReaderSyncClient::SERVER_ERROR;
+  if (!std::isfinite(progress.percentage) || progress.percentage < 0 || progress.percentage > 1 ||
+      !tolino::convertPoint(path, progress.progress, true, point))
+    return fail("Reader position cannot be mapped exactly to Tolino."), KOReaderSyncClient::JSON_ERROR;
+  if (before.exists && before.position == point && std::abs(before.percentage - progress.percentage) < 0.0000001)
+    return KOReaderSyncClient::OK;
+  if (trustedtime::trustedNow() == 0 && !trustedtime::syncNow(10000))
+    return fail("Cannot establish a trusted clock for Tolino writes."), KOReaderSyncClient::SERVER_ERROR;
+  const auto now = static_cast<double>(trustedtime::trustedNow()) * 1000;
+  if (now < 1700000000000.0 || (before.exists && before.modified >= now))
+    return fail("Clock unavailable or newer cloud position exists; pull before retrying."),
+           KOReaderSyncClient::SERVER_ERROR;
+  Cloud fresh;
+  if (!cloud(publication, fresh)) return KOReaderSyncClient::SERVER_ERROR;
+  if (before.revision != fresh.revision || before.exists != fresh.exists || before.modified != fresh.modified)
+    return fail("Cloud position changed; pull before retrying."), KOReaderSyncClient::SERVER_ERROR;
+  if (before.exists && before.bookmarkRevision.empty())
+    return fail("Cloud bookmark revision missing; write refused."), KOReaderSyncClient::SERVER_ERROR;
+  JsonDocument body;
+  body["revision"] = fresh.revision;
+  JsonObject patch = body["patches"].to<JsonArray>().add<JsonObject>();
+  patch["op"] = before.exists ? "replace" : "add";
+  patch["path"] = before.exists ? before.slot : "/publications/" + pointer(publication) + "/bookmark";
+  JsonObject value = patch["value"].to<JsonObject>();
+  if (before.exists) value["revision"] = before.bookmarkRevision;
+  value["position"] = point;
+  value["progress"] = progress.percentage;
+  value["modified"] = now;
+  std::string serialized;
+  serializeJson(body, serialized);
+  JsonDocument response;
+  if (!api("/sync-data?paths=publications", "PATCH", serialized, response)) return KOReaderSyncClient::SERVER_ERROR;
+  Cloud verified;
+  if (!cloud(publication, verified)) return KOReaderSyncClient::SERVER_ERROR;
+  if (!verified.exists || verified.position != point || verified.modified != now ||
+      std::abs(verified.percentage - progress.percentage) > 0.0000001)
+    return fail("Tolino did not confirm the written position; pull before retrying."), KOReaderSyncClient::SERVER_ERROR;
+  return KOReaderSyncClient::OK;
+}
+}  // namespace tolino
