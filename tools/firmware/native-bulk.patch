+KOReaderSyncClient::Error KOReaderSyncClient::registerDocument(const std::string& documentHash,
+                                                               const KOReaderMetadata& metadata) {
+  lastHttpCode = 0;
+  if (!KOREADER_STORE.hasCredentials()) return NO_CREDENTIALS;
+  if (insufficientHeap()) return LOW_MEMORY;
+  JsonDocument doc;
+  auto item = doc["items"].to<JsonArray>().add<JsonObject>();
+  writeMetadata(item, metadata);
+  item["document"] = documentHash;
+  std::string body;
+  serializeJson(doc, body);
+  freeink::SecureHttpClient http;
+  http.setInsecure();
+  if (!http.begin(KOREADER_STORE.getBaseUrl() + "/api/v1/documents")) return NETWORK_ERROR;
+  applyCustomHeaders(http);
+  applyAuthHeaders(http);
+  http.addHeader("Content-Type", "application/json");
+  const int code = http.sendRequest("PUT", body);
+  http.end();
+  lastHttpCode = code;
+  LOG_DBG("KOSync", "Register document response: %d", code);
+  if (code <= 0) return NETWORK_ERROR;
+  if (code >= 200 && code < 300) return OK;
+  if (code == 401) return AUTH_FAILED;
+  return SERVER_ERROR;
+}
