+void PluginCatalogActivity::confirmDownloadAll() {
+  DetailsSpec spec;
+  spec.header = catalogTitle;
+  spec.title = bulkTitle;
+  spec.description = bulkNotice;
+  spec.actionLabel = tr(STR_FETCH);
+  auto confirmation = makeUniqueNoThrow<DetailsActivity>(renderer, mappedInput, std::move(spec));
+  if (!confirmation) {
+    fail(StrId::STR_MEMORY_ERROR);
+    return;
+  }
+  startActivityForResult(std::move(confirmation), [this](const ActivityResult& result) {
+    if (!result.isCancelled) downloadAll();
+  });
+}
+
+void PluginCatalogActivity::downloadAll() {
+  bulkRunning = true;
+  bulkDownloaded = bulkSkipped = 0;
+  page = 1;
+  beginLoading();
+  if (!fetchBrowseResponse()) {
+    bulkRunning = false;
+    return;
+  }
+  HttpDownloader::DownloadError result = HttpDownloader::OK;
+  beginDownload(bulkTitle);
+  for (;;) {
+    if (!parseBrowseResponse()) {
+      bulkRunning = false;
+      return;
+    }
+    const bool more = hasMore;
+    std::vector<Item> batch;
+    {
+      RenderLock lock;
+      releaseRows();
+      std::vector<fui::ListItem>().swap(rowItems);
+      batch.swap(items);
+    }
+    for (const auto& item : batch) {
+      mappedInput.update(true);
+      if (mappedInput.wasReleased(MappedInputManager::Button::Back)) cancelDownload = true;
+      if (cancelDownload) {
+        result = HttpDownloader::ABORTED;
+        break;
+      }
+      statusMessage = std::to_string(bulkDownloaded) + " " + tr(STR_BULK_DOWNLOADED) + ", " +
+                      std::to_string(bulkSkipped) + " " + tr(STR_BULK_SKIPPED) + "\n" + item.title;
+      requestUpdateAndWait();
+      result = downloadBook(item);
+      if (result != HttpDownloader::OK) break;
+      if (lastDownloadSkipped)
+        ++bulkSkipped;
+      else
+        ++bulkDownloaded;
+      LOG_INF("PCAT", "Bulk progress: %u downloaded, %u skipped", static_cast<unsigned>(bulkDownloaded),
+              static_cast<unsigned>(bulkSkipped));
+    }
+    if (result != HttpDownloader::OK || !more) break;
+    if (++page > 1000) {
+      LOG_ERR("PCAT", "Bulk catalog exceeded 1000 pages");
+      result = HttpDownloader::FILE_ERROR;
+      break;
+    }
+    if (browsePaging() != plugincatalogpaging::Paging::Static) {
+      session = makeUniqueNoThrow<freeink::SecureHttpClient>();
+      if (!session) {
+        bulkRunning = false;
+        fail(StrId::STR_MEMORY_ERROR);
+        return;
+      }
+      if (!fetchBrowseResponse()) {
+        bulkRunning = false;
+        return;
+      }
+    }
+    state = State::DOWNLOADING;
+  }
+  bulkRunning = false;
+  session.reset();
+  // Restore the ordinary catalog, never leave the bulk-only response as the visible list.
+  page = 1;
+  session = makeUniqueNoThrow<freeink::SecureHttpClient>();
+  if (!session) {
+    fail(StrId::STR_MEMORY_ERROR);
+    return;
+  }
+  if (!fetchBrowseResponse() || !parseBrowseResponse()) return;
+  statusMessage = std::to_string(bulkDownloaded) + " " + tr(STR_BULK_DOWNLOADED) + ", " + std::to_string(bulkSkipped) +
+                  " " + tr(STR_BULK_SKIPPED);
+  LOG_INF("PCAT", "Bulk finished: %s", statusMessage.c_str());
+  finishDownload(result);
+}
+
+HttpDownloader::DownloadError PluginCatalogActivity::existingBook(const Item& item, const std::string& dest,
+                                                                  bool& found) {
+  found = false;
+  if (!manifest.skipExisting) return HttpDownloader::OK;
+  const bool occupied = Storage.exists(dest.c_str());
+  if (manifest.identityKey.empty()) {
+    if (!occupied) return HttpDownloader::OK;
+    HalFile file = Storage.open(dest.c_str());
+    if (!file || file.isDirectory() || file.size() == 0) return HttpDownloader::FILE_ERROR;
+    found = true;
+    return HttpDownloader::OK;
+  }
+  if (manifest.sidecarPath != "{dest}.meta.json") {
+    LOG_ERR("PCAT", "identity_key requires adjacent metadata sidecars");
+    return HttpDownloader::FILE_ERROR;
+  }
+  JsonDocument expected;
+  if (deserializeJson(expected, substituted(manifest.sidecarBody, &item)) != DeserializationError::Ok)
+    return HttpDownloader::FILE_ERROR;
+  const std::string identity = variantToString(resolvePath(expected.as<JsonVariantConst>(), manifest.identityKey));
+  if (identity.empty()) return HttpDownloader::FILE_ERROR;
+  const std::string folder = dest.substr(0, dest.find_last_of('/'));
+  HalFile dir = Storage.open(folder.empty() ? "/" : folder.c_str());
+  if (!dir || !dir.isDirectory()) return HttpDownloader::FILE_ERROR;
+  for (HalFile file = dir.openNextFile(); file; file = dir.openNextFile()) {
+    char name[256];
+    if (!file.getName(name, sizeof(name))) return HttpDownloader::FILE_ERROR;
+    const std::string path = folder + "/" + name;
+    const bool canonical = strcasecmp(path.c_str(), dest.c_str()) == 0;
+    if (canonical && (file.isDirectory() || file.size() == 0)) return HttpDownloader::FILE_ERROR;
+    if (file.isDirectory()) continue;
+    const std::string metadataPath = path + ".meta.json";
+    if (!Storage.exists(metadataPath.c_str())) {
+      if (canonical) {
+        LOG_ERR("PCAT", "Existing target has no identity sidecar; refusing overwrite");
+        return HttpDownloader::FILE_ERROR;
+      }
+      continue;
+    }
+    std::string raw;
+    JsonDocument metadata;
+    if (!Storage.readFileToString("PCAT", metadataPath, 2048, raw) ||
+        deserializeJson(metadata, raw) != DeserializationError::Ok) {
+      LOG_ERR("PCAT", "Unreadable book sidecar; refusing overwrite");
+      return HttpDownloader::FILE_ERROR;
+    }
+    const std::string actual = variantToString(resolvePath(metadata.as<JsonVariantConst>(), manifest.identityKey));
+    if (canonical && actual != identity) {
+      LOG_ERR("PCAT", "Filename belongs to another book; refusing overwrite");
+      return HttpDownloader::FILE_ERROR;
+    }
+    if (actual == identity) {
+      if (file.size() == 0) return HttpDownloader::FILE_ERROR;
+      found = true;
+    }
+  }
+  if (occupied && !found) {
+    LOG_ERR("PCAT", "Existing target could not be verified; refusing overwrite");
+    return HttpDownloader::FILE_ERROR;
+  }
+  return HttpDownloader::OK;
+}
