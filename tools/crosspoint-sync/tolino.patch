new file mode 100644
index 0000000..d5fdd92
--- /dev/null
+++ b/src/connectors/tolino-epub.ts
@@ -0,0 +1,139 @@
+import { posix } from 'node:path';
+import type { Element, Node } from '@xmldom/xmldom';
+import { epubPosition, withChapter, type Epub } from './bookfusion-epub.js';
+import { ConnectorOperationError } from './types.js';
+
+function invalid(): never {
+  throw new ConnectorOperationError('Tolino position cannot be resolved exactly in the downloaded EPUB', false);
+}
+
+function children(node: Node): Node[] { return Array.from(node.childNodes ?? []); }
+function elements(node: Node): Element[] {
+  return children(node).filter((node): node is Element => node.nodeType === 1);
+}
+function isText(node: Node): boolean { return node.nodeType === 3 || node.nodeType === 4; }
+// RMSDK counts DOM siblings, including formatting whitespace and comments, but not processing instructions.
+function enumerable(node: Node): Node[] { return children(node).filter(node => node.nodeType !== 7); }
+function localName(node: Node): string { return (node as Element).localName ?? ''; }
+const HIDDEN = new Set(['head', 'style', 'script', 'title', 'rp']);
+
+function safePath(value: string): string {
+  let decoded: string;
+  try { decoded = decodeURIComponent(value); } catch { return invalid(); }
+  if (!decoded || decoded.startsWith('/') || decoded.includes('\\') || /[\u0000-\u001f?#]/.test(decoded)) invalid();
+  const normalized = posix.normalize(decoded);
+  if (normalized === '..' || normalized.startsWith('../')) invalid();
+  return normalized;
+}
+
+function fromBytes(value: string, offset: number): number {
+  if (!Number.isSafeInteger(offset) || offset < 0) invalid();
+  let bytes = 0, count = 0;
+  for (const character of value) {
+    if (bytes === offset) return count;
+    bytes += Buffer.byteLength(character);
+    count++;
+    if (bytes > offset) invalid();
+  }
+  return bytes === offset ? count : invalid();
+}
+
+function xpath(html: Element, body: Element, target: Node, index: number, offset: number): string {
+  const path: string[] = [];
+  let current = target;
+  for (; current !== body; current = current.parentNode ?? invalid()) {
+    if (current === html || (current.nodeType !== 1 && !isText(current))) invalid();
+    const parent = current.parentNode ?? invalid();
+    if (isText(current)) {
+      if (current !== target) invalid();
+      const siblings = children(parent).filter(isText);
+      path.unshift(`text()[${siblings.indexOf(current) + 1}].${offset}`);
+    } else {
+      if (HIDDEN.has(localName(current))) invalid();
+      const siblings = elements(parent).filter(node => localName(node) === localName(current));
+      path.unshift(`${localName(current)}[${siblings.indexOf(current as Element) + 1}]`);
+    }
+  }
+  return `/body/DocFragment[${index + 1}]/body` + (path.length ? '/' + path.join('/') : '');
+}
+
+/** RMSDK #point uses one-based DOM children and UTF-8 byte offsets, not CFI steps or percentages. */
+export async function tolinoXPath(epub: Epub, locator: string): Promise<string> {
+  const match = /^([^#]+)#point\(\/1((?:\/[1-9]\d*)+):(\d+)\)$/.exec(locator);
+  if (!match || locator.length > 4096) invalid();
+  const chapter = safePath(match[1]);
+  return withChapter(epub, (opf, _spine, items, opfPath) => {
+    const manifest = elements(opf).find(node => localName(node) === 'manifest') ?? invalid();
+    const found: number[] = [];
+    for (const [index, item] of items.entries()) {
+      const file = elements(manifest).find(node => node.getAttribute('id') === item.getAttribute('idref'));
+      if (!file) invalid();
+      const href = file.getAttribute('href')?.split('#')[0] ?? invalid();
+      const resolved = posix.normalize(posix.join(posix.dirname(opfPath), decodeURIComponent(href)));
+      const alias = posix.normalize(decodeURIComponent(href));
+      if (chapter === resolved || chapter === posix.basename(resolved) ||
+          (!alias.startsWith('../') && chapter === alias)) found.push(index);
+    }
+    return found.length === 1 ? found[0] : invalid();
+  }, ({ html, body, index }) => {
+    let node: Node = html;
+    for (const step of match[2].slice(1).split('/')) {
+      const number = Number(step);
+      if (!Number.isSafeInteger(number)) invalid();
+      node = enumerable(node)[number - 1] ?? invalid();
+    }
+    let offset = fromBytes(node.textContent ?? '', Number(match[3]));
+    if (node.nodeType === 1 && offset > 0) {
+      // Element offsets are measured over descendant text, not an estimated paragraph.
+      const root = node;
+      let found: Node | null = null;
+      for (let current: Node | null = root; current;) {
+        if (isText(current)) {
+          const length = Array.from(current.nodeValue ?? '').length;
+          if (offset <= length) { found = current; break; }
+          offset -= length;
+        }
+        if (current.firstChild) { current = current.firstChild; continue; }
+        while (current !== root && !current.nextSibling) current = current.parentNode!;
+        current = current === root ? null : current.nextSibling;
+      }
+      node = found ?? invalid();
+    }
+    return xpath(html, body, node, index, offset);
+  });
+}
+
+/** Resolve the actual XPath first; translate codepoints to UTF-8 bytes only at the selected text node. */
+export async function tolinoPoint(epub: Epub, progress: string): Promise<string> {
+  await epubPosition(epub, progress);
+  const match = /^\/body\/DocFragment(?:\[(\d+)\])?\/body(?:\/(.*))?$/.exec(progress) ?? invalid();
+  return withChapter(epub, () => Number(match[1] ?? 1) - 1, async ({ html, body, path }) => {
+    let node: Node = body;
+    let offset = 0;
+    for (const part of match[2]?.split('/') ?? []) {
+      const text = /^text\(\)(?:\[(\d+)\])?(?:\.(\d+))?$/.exec(part);
+      if (text) {
+        node = children(node).filter(isText)[Number(text[1] ?? 1) - 1] ?? invalid();
+        offset = Number(text[2] ?? 0);
+      } else {
+        const element = /^([\w:.-]+)(?:\[(\d+)\])?$/.exec(part) ?? invalid();
+        node = elements(node).filter(child => localName(child) === element[1].split(':').pop())[
+          Number(element[2] ?? 1) - 1] ?? invalid();
+        if (HIDDEN.has(localName(node))) invalid();
+      }
+    }
+    const value = Array.from(node.textContent ?? '');
+    if (!Number.isSafeInteger(offset) || offset > value.length) invalid();
+    const bytes = Buffer.byteLength(value.slice(0, offset).join(''));
+    const steps: number[] = [];
+    for (let current = node; current !== html; current = current.parentNode ?? invalid()) {
+      if (!current.parentNode) invalid();
+      steps.unshift(enumerable(current.parentNode).indexOf(current) + 1);
+    }
+    const locator = `${path.split('/').map(encodeURIComponent).join('/')}#point(/1/${steps.join('/')}:${bytes})`;
+    const roundtrip = await tolinoXPath(epub, locator);
+    // Both representations must anchor the same node; do not silently fall back to a percentage.
+    await epubPosition(epub, roundtrip);
+    return locator;
+  });
+}
diff --git a/src/connectors/tolino.ts b/src/connectors/tolino.ts
new file mode 100644
index 0000000..5c375b9
--- /dev/null
+++ b/src/connectors/tolino.ts
@@ -0,0 +1,152 @@
+import { createHash } from 'node:crypto';
+import { cachedEpub } from './bookfusion-epub.js';
+import { tolinoPoint, tolinoXPath } from './tolino-epub.js';
+import { ConnectorOperationError, type Connector, type ConnectorContext, type Credential,
+  type HttpTransport, type Match } from './types.js';
+
+function failure(message: string, retryable = false): never {
+  throw new ConnectorOperationError(message, retryable);
+}
+
+function connection(credential: Credential) {
+  // An operator-configured destination, never a user-controlled server-side fetch URL.
+  const url = new URL(process.env.TOLINO_HELPER_URL ?? 'http://127.0.0.1:8081');
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password ||
+      url.pathname !== '/' || url.search || url.hash) failure('Invalid TOLINO_HELPER_URL');
+  const token = credential.token;
+  if (typeof token !== 'string' || token.length < 32 || /[^\x21-\x7e]/.test(token)) {
+    failure('A valid Tolino helper API key is required');
+  }
+  return { origin: url.origin, headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' } };
+}
+
+function check(status: number): void {
+  if (status >= 200 && status < 300) return;
+  throw new ConnectorOperationError(
+    `Tolino helper request failed (HTTP ${status})`, status === 429 || status >= 500, status === 401
+  );
+}
+
+interface Remote {
+  revision: string;
+  position: { progress: number; position: string; modified: number } | null;
+}
+
+async function remote(credential: Credential, id: string, http: HttpTransport): Promise<Remote> {
+  const { origin, headers } = connection(credential);
+  const res = await http(`${origin}/api/sync-position?id=${encodeURIComponent(id)}`, {
+    method: 'GET', headers, redirect: 'error', signal: AbortSignal.timeout(10_000),
+  });
+  check(res.status);
+  const data = await res.json() as Partial<Remote> | null;
+  if (!data || typeof data.revision !== 'string' || !data.revision) failure('Invalid Tolino cloud revision');
+  const p = data.position;
+  if (p !== null && (!p || typeof p.position !== 'string' || typeof p.progress !== 'number' ||
+      !Number.isFinite(p.progress) || p.progress < 0 || p.progress > 1 || typeof p.modified !== 'number' ||
+      !Number.isFinite(p.modified) || p.modified < 0)) failure('Invalid Tolino reading position');
+  return { revision: data.revision, position: p };
+}
+
+/** Match CrossPoint/KOReader's binary partial MD5; never use filename or fuzzy title matching for position writes. */
+export function tolinoDocumentHash(bytes: Buffer): string {
+  const hash = createHash('md5');
+  for (let i = -1; i < 11; i++) {
+    const offset = i < 0 ? 0 : 1024 * 4 ** i;
+    if (offset < bytes.length) hash.update(bytes.subarray(offset, Math.min(offset + 1024, bytes.length)));
+  }
+  return hash.digest('hex');
+}
+
+async function book(credential: Credential, match: Match, http: HttpTransport, ctx?: ConnectorContext) {
+  if (!match.fromSidecar || !ctx?.document) failure('Tolino sync requires the downloaded book sidecar and binary document matching');
+  const { origin, headers } = connection(credential);
+  return cachedEpub(['tolino', origin, credential.token, match.externalId, ctx.document], async signal => {
+    const res = await http(`${origin}/api/download?id=${encodeURIComponent(match.externalId)}`, {
+      method: 'GET', headers, redirect: 'error', signal,
+    });
+    check(res.status);
+    if (!res.body) failure('Tolino EPUB response has no body');
+    const reader = res.body.getReader(), chunks: Uint8Array[] = [];
+    let size = 0;
+    try {
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        size += value.length;
+        if (size > 200 * 1024 * 1024) failure('Tolino EPUB exceeds 200 MiB');
+        chunks.push(value);
+      }
+    } finally { await reader.cancel(); reader.releaseLock(); }
+    const bytes = Buffer.concat(chunks, size);
+    if (tolinoDocumentHash(bytes) !== ctx.document) failure('Tolino EPUB edition mismatch: use binary matching and the same downloaded EPUB');
+    return { ...res, body: new ReadableStream({ start(controller) { controller.enqueue(bytes); controller.close(); } }) };
+  });
+}
+
+export const tolinoConnector: Connector = {
+  id: 'tolino',
+  displayName: 'Tolino / Thalia (local helper)',
+  tier: 3,
+  capabilities: { read: true, write: true },
+  carries: ['progress', 'finished'],
+  credentialKind: 'token',
+  beta: true,
+  options: [
+    { key: 'progress', label: 'Send reading positions to Tolino', default: false, gates: 'progress' },
+    { key: 'finished', label: 'Send finished reading positions to Tolino', default: false, gates: 'finished' },
+  ],
+  async validate(credential, http) {
+    const { origin, headers } = connection(credential);
+    const res = await http(`${origin}/api/sync-status`, { method: 'GET', headers, redirect: 'error',
+      signal: AbortSignal.timeout(10_000) });
+    check(res.status);
+    const status = await res.json() as { connected?: unknown };
+    return status?.connected === true ? { ok: true, accountLabel: 'Local Tolino Bridge' }
+      : { ok: false, error: 'Sign in on the Tolino helper dashboard first' };
+  },
+  async match() { return null; },
+  async pullProgress(credential, match, http, sinceMs, ctx) {
+    if (!match.fromSidecar) return null;
+    const cloud = await remote(credential, match.externalId, http);
+    if (!cloud.position) return null;
+    const epub = await book(credential, match, http, ctx);
+    const progress = await tolinoXPath(epub, cloud.position.position);
+    return { externalId: match.externalId, percentage: cloud.position.progress, progress,
+      finished: cloud.position.progress === 1, updatedAtMs: cloud.position.modified, furthestReadOnly: true };
+  },
+  async push(credential, match, event, http, ctx) {
+    if (typeof event.progress !== 'string' || typeof event.percentage !== 'number' ||
+        !Number.isFinite(event.percentage) || event.percentage < 0 || event.percentage > 1 ||
+        !Number.isSafeInteger(event.timestamp) || event.timestamp < 0) failure('An exact timestamped reader position is required');
+    const cloud = await remote(credential, match.externalId, http);
+    // Queued events must never undo a newer cloud session, even if it is further back in the book.
+    if (cloud.position && Math.floor(cloud.position.modified / 1000) > event.timestamp) {
+      return { ok: true, note: 'Newer Tolino cloud position retained; pull before continuing' };
+    }
+    const epub = await book(credential, match, http, ctx);
+    const position = await tolinoPoint(epub, event.progress);
+    const { origin, headers } = connection(credential);
+    const body = JSON.stringify({
+      id: match.externalId, revision: cloud.revision, expectedModified: cloud.position?.modified ?? null,
+      position, progress: event.percentage, modified: event.timestamp * 1000,
+    });
+    let res;
+    try {
+      res = await http(`${origin}/api/sync-position`, { method: 'PUT', headers, redirect: 'error',
+        signal: AbortSignal.timeout(120_000), body });
+    } catch (error) {
+      if (!(error instanceof Error)) throw error;
+      failure('Tolino write outcome is unknown; pull before retrying');
+    }
+    if (res.status === 409) return { ok: false, retryable: false, error: 'Tolino conflict: pull cloud position before retrying' };
+    if (res.status < 200 || res.status >= 300) failure(`Tolino write failed (HTTP ${res.status}); pull before retrying`);
+    let result: { synced?: unknown };
+    try { result = await res.json() as { synced?: unknown }; }
+    catch (error) {
+      if (!(error instanceof Error)) throw error;
+      failure('Tolino write response is invalid; pull before retrying');
+    }
+    if (result?.synced !== true) failure('Tolino write not confirmed; pull before retrying');
+    return { ok: true };
+  },
+};
